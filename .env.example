# ------------------------------------------------------------------------------
# 1. Primary LLM Provider (Groq API)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b



# ------------------------------------------------------------------------------
# 2. Fallback Tier 1: OpenRouter (Free / Low-Cost Remote Tier)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_oopenrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free


# ------------------------------------------------------------------------------
# 3. Fallback Tier 2 & Offline Mode: Local llama.cpp (CPU Only)
# ------------------------------------------------------------------------------
# Set to 'true' or run with CLI flag --offline to force local-only inference
OFFLINE_MODE=false
LOCAL_MODEL_PATH=models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_TIMEOUT_SECONDS=180.0
LOCAL_LLM_MAX_OUTPUT_TOKENS=1024
LOCAL_LLM_N_THREADS=8
LOCAL_LLM_N_CTX=2048


# ------------------------------------------------------------------------------
# 4. Observability, Traces & SQLite Logging
# ------------------------------------------------------------------------------
SWARM_DB_PATH=memory/swarm_log.db
SWARM_LOG_FULL_TEXT=true
LLM_USAGE_LOG=memory/llm_usage.jsonl


# ------------------------------------------------------------------------------
# 5. HuggingFace & RAG Embedding Cache
# ------------------------------------------------------------------------------
HF_HOME=work/hf-cache
